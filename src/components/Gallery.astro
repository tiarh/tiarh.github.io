---
// Screenshot grid + a small <dialog> lightbox (no library). All images are demo/seeder data.
import type { Shot } from '../data/projects';

interface Props {
  shots: Shot[];
}

const { shots } = Astro.props;
---

<div class="gallery" data-gallery>
  {shots.map((s, i) => (
    <figure class:list={['gallery-item', s.width < s.height && 'gallery-item--tall']}>
      <button type="button" class="gallery-thumb" data-index={i} aria-label={`Open screenshot: ${s.caption}`}>
        <img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
      </button>
      <figcaption class="mt-3 text-sm text-faint">{s.caption}</figcaption>
    </figure>
  ))}
</div>

<dialog class="lightbox" data-lightbox aria-label="Screenshot viewer">
  <div class="lightbox-bar">
    <p class="lightbox-caption text-sm text-muted" data-caption></p>
    <div class="flex items-center gap-1">
      <button type="button" class="lightbox-btn" data-prev aria-label="Previous screenshot"><i class="ph ph-caret-left"></i></button>
      <button type="button" class="lightbox-btn" data-next aria-label="Next screenshot"><i class="ph ph-caret-right"></i></button>
      <button type="button" class="lightbox-btn" data-close aria-label="Close"><i class="ph ph-x"></i></button>
    </div>
  </div>
  <div class="lightbox-body">
    <img data-full src={shots[0]?.src} alt={shots[0]?.alt ?? ''} loading="lazy" decoding="async" />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
    if (!dialog) return;
    const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));
    const full = dialog.querySelector<HTMLImageElement>('[data-full]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + thumbs.length) % thumbs.length;
      const img = thumbs[current].querySelector('img')!;
      full.src = img.src;
      full.alt = img.alt;
      caption.textContent = thumbs[current].closest('figure')?.querySelector('figcaption')?.textContent ?? '';
    };

    thumbs.forEach((t, i) =>
      t.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      })
    );
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop (outside the image) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox-body')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>
