---
// One CV, two languages. The same markup is the /cv page and the PDF (scripts/build-cv.mjs prints it).
import { PROFILE } from '../data/profile';
import experience, { type Lang } from '../data/experience';
import { PROJECTS } from '../data/projects';
import { CERTIFICATES } from '../data/certificates';
import { CV_LABELS, CV_SUMMARY, EDUCATION, SKILLS } from '../data/cv';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = CV_LABELS[lang];
const otherHref = lang === 'en' ? '/cv/id' : '/cv';
const pdf = PROFILE.cv[lang];
const cvProjects = PROJECTS.filter((p) => p.slug !== 'whatsapp-ops-bot');
const c = PROFILE.contacts;
---

<main class="cv wrap pb-24 pt-28 md:pt-32">
  <div class="no-print mb-10 flex flex-wrap gap-3">
    <a href={pdf} download class="btn btn-primary">
      <i class="ph ph-download-simple text-base" aria-hidden="true"></i>
      {L.download}
    </a>
    <a href={otherHref} class="btn btn-secondary" hreflang={lang === 'en' ? 'id' : 'en'}>
      <i class="ph ph-translate text-base" aria-hidden="true"></i>
      {L.other}
    </a>
  </div>

  <header>
    <h1 class="display text-4xl md:text-5xl">{PROFILE.name}</h1>
    <p class="mt-2 text-lg text-accent">{experience[0].title[lang]} · Skynet</p>
    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
      <a href={c.email.href}>{c.email.label}</a>
      <a href={c.whatsapp.href}>{c.whatsapp.label}</a>
      <a href={c.linkedin.href}>{c.linkedin.label}</a>
      <a href={c.github.href}>github.com/{c.github.label}</a>
      <a href="https://tiarh.github.io">tiarh.github.io</a>
      <span>{lang === 'en' ? 'Pamekasan, East Java' : 'Pamekasan, Jawa Timur'}</span>
    </p>
  </header>

  <section>
    <h2>{L.summary}</h2>
    <p class="mt-3 leading-relaxed text-muted">{CV_SUMMARY[lang]}</p>
  </section>

  <section>
    <h2>{L.experience}</h2>
    {experience.map((e) => (
      <div class="cv-entry mt-4">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <h3 class="font-semibold">{e.title[lang]} — <span class="text-accent">{e.company[lang]}</span></h3>
          <p class="font-mono text-xs text-faint">{e.period[lang]} · {e.location[lang]}</p>
        </div>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-muted">
          {e.highlights[lang].map((h) => <li>{h}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section>
    <h2>{L.projects}</h2>
    <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
      {cvProjects.map((p) => (
        <li class="cv-entry">
          <strong class="font-semibold text-ink">{p.title.split(' — ')[0]}</strong> — {p.cv[lang]}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{L.skills}</h2>
    <dl class="mt-3 grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[11rem_1fr]">
      {SKILLS.map((s) => (
        <>
          <dt class="font-semibold text-ink">{s.title[lang]}</dt>
          <dd class="leading-relaxed text-muted">{s.items[lang]}</dd>
        </>
      ))}
    </dl>
  </section>

  <section class="cv-entry">
    <h2>{L.education}</h2>
    <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-4 text-sm">
      <p><strong class="font-semibold text-ink">{EDUCATION.school}</strong> — <span class="text-muted">{EDUCATION.degree[lang]}</span></p>
      <p class="font-mono text-xs text-faint">{EDUCATION.period[lang]}</p>
    </div>
  </section>

  <section class="cv-entry">
    <h2>{L.certificates}</h2>
    <ul class="mt-3 space-y-1 text-sm text-muted">
      {CERTIFICATES.map((cert) => (
        <li>
          <strong class="font-semibold text-ink">{cert.title}</strong> — {cert.issuer}{cert.date && ` · ${cert.date}`}{cert.credentialId && ` · ID ${cert.credentialId}`}
        </li>
      ))}
    </ul>
  </section>
</main>
