---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { PROJECTS, shotSrcset } from '../../data/projects';
---

<BaseLayout title="Projects — Ikhtiar Hidayatullah" description="Network and software projects from running an FTTH ISP: billing, WhatsApp installs, outage detection, monitoring, MikroTik." canonical="https://tiarh.github.io/projects" ogImage="/og/projects.png">
  <SiteHeader />

  <main class="wrap min-h-screen pb-24 pt-28 md:pt-32">
    <h1 class="display text-4xl md:text-5xl">Projects</h1>
    <p class="mt-4 max-w-[56ch] leading-relaxed text-muted">
      Network and software work from running an FTTH ISP — each with the problem, my role, what I built and what changed.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {PROJECTS.map((p) => (
        <a href={`/projects/${p.slug}`} class="reveal panel panel-raised group flex flex-col overflow-hidden">
          {p.gallery?.[0] && (
            <img
              src={p.gallery[0].src}
              srcset={shotSrcset(p.gallery[0])}
              sizes="(min-width: 768px) 600px, 92vw"
              alt=""
              width={p.gallery[0].width}
              height={p.gallery[0].height}
              class="aspect-[16/9] w-full border-b border-line object-cover object-left-top"
              loading="lazy"
              decoding="async"
            />
          )}
          <div class="flex flex-1 flex-col p-6 md:p-8">
            <div class="flex items-start justify-between gap-3">
              <h2 class="text-xl font-semibold tracking-tight transition-colors group-hover:text-accent">{p.title}</h2>
              <span class="tag shrink-0">{p.status}</span>
            </div>
            <p class="mt-4 leading-relaxed text-muted">{p.summary}</p>
            <div class="mt-6 flex flex-wrap gap-2">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <span class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-accent">
              Read case study
              <i class="ph ph-arrow-right text-base transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <SiteFooter back={{ href: '/', label: 'Home' }} />

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
