---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { PROJECTS } from '../../data/projects';

export const prerender = true;

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = PROJECTS.find((p) => p.slug === slug);
if (!project) throw new Error('Project not found');
---

<BaseLayout
  title={`${project.title} — Projects`}
  description={project.description}
  canonical={`https://tiarh.github.io/projects/${project.slug}`}
  ogImage={`/og/project-${project.slug}.png`}
>
  <SiteHeader />

  <main class="wrap min-h-screen pb-24 pt-28 md:pt-32">
    <article>
      <a href="/projects" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent">
        <i class="ph ph-arrow-left" aria-hidden="true"></i>Projects
      </a>

      <h1 class="display mt-6 max-w-[26ch] text-4xl md:text-5xl">{project.title}</h1>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <span class="tag border-accent/30 text-accent">{project.status}</span>
        {project.tags.map((t) => <span class="tag">{t}</span>)}
      </div>

      <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-muted">{project.description}</p>

      <div class="mt-14 grid gap-6">
        <section class="panel p-8">
          <h2 class="mono-label">Problem</h2>
          <p class="mt-4 leading-relaxed text-muted">{project.caseStudy.problem}</p>
        </section>
        <section class="panel p-8">
          <h2 class="mono-label">Solution</h2>
          <p class="mt-4 leading-relaxed text-muted">{project.caseStudy.solution}</p>
        </section>
        <section class="panel border-accent/20 p-8">
          <h2 class="mono-label text-accent">Outcome</h2>
          <p class="mt-4 leading-relaxed text-muted">{project.caseStudy.outcome}</p>
        </section>
      </div>

      {project.metrics && project.metrics.length > 0 && (
        <section class="mt-14">
          <h2 class="display mb-6 text-2xl">Impact</h2>
          <ul class="divide-y divide-line border-y border-line">
            {project.metrics.map((m) => (
              <li class="flex items-start gap-3 py-4 text-muted">
                <i class="ph ph-trend-up mt-1 shrink-0 text-accent" aria-hidden="true"></i>
                {m}
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="mt-14">
        <h2 class="display mb-6 text-2xl">Highlights</h2>
        <ul class="space-y-3">
          {project.highlights.map((h) => (
            <li class="flex items-start gap-3 text-muted">
              <i class="ph ph-check mt-1 shrink-0 text-accent" aria-hidden="true"></i>
              {h}
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-14">
        <h2 class="display mb-6 text-2xl">Stack</h2>
        <div class="flex flex-wrap gap-2">
          {project.caseStudy.stack.map((s) => (
            <span class="tag">{s}</span>
          ))}
        </div>
      </section>

      <section class="mt-14">
        <h2 class="display mb-6 text-2xl">Diagram</h2>
        <div class="panel bg-surface-2 p-8">
          <img
            src={`/projects/${project.slug}/diagram.svg`}
            alt={`${project.title} diagram`}
            class="h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>

      {(project.links?.repo || project.links?.demo) && (
        <section class="mt-14">
          <h2 class="display mb-6 text-2xl">Links</h2>
          <div class="flex flex-wrap gap-3">
            {project.links?.repo && (
              <a class="btn btn-secondary" href={project.links.repo} target="_blank" rel="noopener noreferrer">
                <i class="ph ph-github-logo text-base" aria-hidden="true"></i>
                Source / Repo
              </a>
            )}
            {project.links?.demo && (
              <a class="btn btn-secondary" href={project.links.demo} target="_blank" rel="noopener noreferrer">
                <i class="ph ph-globe text-base" aria-hidden="true"></i>
                Demo
              </a>
            )}
          </div>
        </section>
      )}
    </article>
  </main>

  <footer class="border-t border-line">
    <div class="wrap flex items-center justify-between py-8 text-sm text-faint">
      <a href="/" class="transition-colors hover:text-accent"><i class="ph ph-arrow-left mr-1.5" aria-hidden="true"></i>Home</a>
      <p class="font-mono text-xs">© 2026 Ikhtiar Hidayatullah</p>
    </div>
  </footer>
</BaseLayout>
