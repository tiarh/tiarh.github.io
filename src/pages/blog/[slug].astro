---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

export const prerender = true;

export function getStaticPaths() {
  const modules = import.meta.glob('../../content/blog/*.md', { eager: true });
  return Object.entries(modules).map(([file, post]) => ({
    params: { slug: file.split('/').pop().replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = post;
const fm = post.frontmatter;
const slug = Astro.params.slug;
---

<BaseLayout title={`${fm.title} — Notes`} description={fm.description} canonical={`https://tiarh.github.io/blog/${slug}`} ogImage={`/og/blog-${slug}.png`}>
  <SiteHeader />

  <main class="wrap min-h-screen pb-24 pt-28 md:pt-32">
    <article class="mx-auto max-w-[72ch]">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent">
        <i class="ph ph-arrow-left" aria-hidden="true"></i>Notes
      </a>

      <h1 class="display mt-6 text-4xl md:text-5xl">{fm.title}</h1>
      <p class="mt-4 font-mono text-xs text-faint">{new Date(fm.pubDate).toLocaleDateString('id-ID')}</p>

      <div class="prose mt-12">
        <Content />
      </div>
    </article>
  </main>

  <footer class="border-t border-line">
    <div class="wrap flex items-center justify-between py-8 text-sm text-faint">
      <a href="/" class="transition-colors hover:text-accent"><i class="ph ph-arrow-left mr-1.5" aria-hidden="true"></i>Home</a>
      <p class="font-mono text-xs">© 2026 Ikhtiar Hidayatullah</p>
    </div>
  </footer>
</BaseLayout>
