---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { CERTIFICATES } from '../../data/certificates';
---

<BaseLayout title="Certificates — Ikhtiar Hidayatullah" canonical="https://tiarh.github.io/certificates" ogImage="/og/home.png">
  <SiteHeader />

  <main class="wrap min-h-screen pb-24 pt-28 md:pt-32">
    <h1 class="display text-4xl md:text-5xl">Certificates & training</h1>
    <p class="mt-4 max-w-[52ch] leading-relaxed text-muted">
      Pelatihan dan sertifikasi di bidang jaringan, DevOps, dan security.
    </p>

    {CERTIFICATES.length === 0 ? (
      <div class="panel mt-10 p-8 text-muted">
        Belum ada data sertifikat. Kirim daftar sertifikat (judul + issuer + link) untuk ditambahkan.
      </div>
    ) : (
      <div class="mt-12 divide-y divide-line border-y border-line">
        {CERTIFICATES.map((c) => (
          <article class="reveal flex flex-wrap items-start justify-between gap-4 py-7">
            <div>
              <h2 class="text-lg font-semibold tracking-tight">{c.title}</h2>
              <p class="mt-1 text-sm text-muted">{c.issuer}</p>
              {c.credentialId && (
                <p class="mt-3 font-mono text-xs text-faint">ID: {c.credentialId}</p>
              )}
              {c.url && (
                <a class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-ink" href={c.url} target="_blank" rel="noreferrer">
                  Lihat kredensial <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              )}
            </div>
            {c.date && <span class="shrink-0 font-mono text-xs text-faint">{c.date}</span>}
          </article>
        ))}
      </div>
    )}
  </main>

  <footer class="border-t border-line">
    <div class="wrap flex items-center justify-between py-8 text-sm text-faint">
      <a href="/" class="transition-colors hover:text-accent"><i class="ph ph-arrow-left mr-1.5" aria-hidden="true"></i>Home</a>
      <p class="font-mono text-xs">© 2026 Ikhtiar Hidayatullah</p>
    </div>
  </footer>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
