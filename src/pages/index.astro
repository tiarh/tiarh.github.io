---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { PROJECTS } from "../data/projects";
import { STATS } from "../data/stats";
import experience from "../data/experience";

const featuredSlugs = ["monitoring-automation-skynet", "dual-wan-failover-pcc"];
const featured = PROJECTS.filter((p) => featuredSlugs.includes(p.slug));
const [mainProject, secondProject] = featured;

const stack = [
  { name: "MikroTik", slug: "mikrotik" },
  { name: "Linux", slug: "linux" },
  { name: "Python", slug: "python" },
  { name: "Nginx", slug: "nginx" },
  { name: "Docker", slug: "docker" },
  { name: "Grafana", slug: "grafana" },
  { name: "PostgreSQL", slug: "postgresql" },
  { name: "Git", slug: "git" },
];

const skillGroups = [
  {
    title: "Networking & Routing",
    items: [
      "MikroTik RouterOS",
      "PPPoE",
      "VLAN",
      "Routing RIP / OSPF / BGP",
      "Recursive failover",
      "PCC load balancing",
      "QoS / PCQ",
    ],
  },
  {
    title: "Systems & Automation",
    items: [
      "Linux server admin",
      "Nginx",
      "Docker",
      "systemd & cron",
      "Python",
      "Bash scripting",
      "Playwright automation",
    ],
  },
  {
    title: "Monitoring & Tooling",
    items: [
      "Prometheus",
      "Grafana",
      "MySQL / PostgreSQL",
      "Git",
      "SSH hardening",
      "Incident triage",
    ],
  },
];

const certs = [
  { name: "Pemasangan Jaringan Komputer", org: "UPT BLK Surabaya", date: "Okt 2025" },
  { name: "Network Penetration Testing", org: "Cyber Academy Indonesia", date: "Agu 2024" },
  { name: "Fundamentals of DevOps", org: "Dicoding Indonesia", date: "Sep 2023" },
];

const contacts = [
  { icon: "ph-whatsapp-logo", label: "WhatsApp", href: "https://wa.me/6285234415861" },
  { icon: "ph-telegram-logo", label: "Telegram", href: "https://t.me/lumayancuk" },
  { icon: "ph-github-logo", label: "GitHub", href: "https://github.com/tiarh" },
  { icon: "ph-linkedin-logo", label: "LinkedIn", href: "https://www.linkedin.com/in/ikhtiarh" },
];
---

<BaseLayout title="Ikhtiar Hidayatullah — Network Engineer & NOC Specialist">
  <SiteHeader />

  <main>
    <!-- HERO -->
    <section class="wrap flex min-h-[100dvh] flex-col justify-center pb-16 pt-28 md:pt-32">
      <div class="grid items-center gap-12 lg:grid-cols-[1.3fr_0.7fr]">
        <div>
          <p class="mb-6 flex items-center gap-2.5 font-mono text-xs tracking-wide text-muted">
            <span class="status-dot"></span>
            Available for opportunities
          </p>

          <h1 class="display text-6xl md:text-7xl xl:text-[5.5rem]">
            Ikhtiar<br />Hidayatullah
          </h1>

          <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-muted">
            NOC engineer keeping ISP networks stable — MikroTik routing,
            PPPoE, Linux, and monitoring automation.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/files/Ikhtiar_Hidayatullah_CV.pdf" download class="btn btn-primary">
              <i class="ph ph-download-simple text-base" aria-hidden="true"></i>
              Download CV
            </a>
            <a href="#work" class="btn btn-secondary">
              View work
              <i class="ph ph-arrow-down text-base" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <figure class="panel mx-auto w-full max-w-[260px] overflow-hidden md:max-w-[300px]">
          <img
            src="/images/profile.jpg"
            alt="Portrait of Ikhtiar Hidayatullah"
            class="aspect-[4/5] w-full object-cover grayscale-[15%]"
            width="640"
            height="800"
            loading="eager"
          />
        </figure>
      </div>

      <!-- Ops track record -->
      <dl class="mt-20 grid grid-cols-2 gap-y-8 border-t border-line pt-8 md:grid-cols-4">
        {STATS.map((s) => (
          <div>
            <dd class="font-mono text-2xl font-medium text-ink">{s.value}</dd>
            <dt class="mt-1 text-sm text-faint">{s.label}</dt>
          </div>
        ))}
      </dl>
    </section>

    <!-- STACK STRIP -->
    <section class="border-y border-line" aria-label="Core stack">
      <div class="wrap flex flex-wrap items-center gap-x-8 gap-y-4 py-6">
        {stack.map((tool) => (
          <span class="flex items-center gap-2 text-sm text-muted">
            <img
              src={`https://cdn.simpleicons.org/${tool.slug}/a4aab1`}
              alt=""
              width="18"
              height="18"
              loading="lazy"
            />
            {tool.name}
          </span>
        ))}
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section id="work" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Selected work</h2>

      {mainProject && (
        <article class="reveal panel panel-raised overflow-hidden">
          <div class="grid md:grid-cols-[1.1fr_0.9fr]">
            <div class="p-8 md:p-10">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-xl font-semibold tracking-tight">{mainProject.title}</h3>
                <span class="tag border-accent/30 text-accent">{mainProject.status}</span>
              </div>
              <p class="mt-4 max-w-[52ch] leading-relaxed text-muted">
                {mainProject.description}
              </p>
              <ul class="mt-6 space-y-2">
                {mainProject.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <i class="ph ph-check mt-0.5 text-accent" aria-hidden="true"></i>
                    {h}
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-2">
                {mainProject.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <a
                href={`/projects/${mainProject.slug}`}
                class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-ink"
              >
                Read case study
                <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
              </a>
            </div>
            <div class="hidden items-center border-l border-line bg-surface-2 p-8 md:flex">
              <img
                src="/projects/monitoring-automation-skynet/diagram.svg"
                alt={`${mainProject.title} architecture diagram`}
                class="w-full"
                loading="lazy"
              />
            </div>
          </div>
        </article>
      )}

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {secondProject && (
          <article class="reveal panel panel-raised flex flex-col p-8">
            <div class="flex flex-wrap items-center gap-3">
              <h3 class="text-xl font-semibold tracking-tight">{secondProject.title}</h3>
              <span class="tag border-accent/30 text-accent">{secondProject.status}</span>
            </div>
            <p class="mt-4 leading-relaxed text-muted">{secondProject.description}</p>
            <div class="mt-auto pt-6">
              <a
                href={`/projects/${secondProject.slug}`}
                class="inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-ink"
              >
                Read case study
                <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
              </a>
            </div>
          </article>
        )}

        <a href="/projects" class="reveal panel panel-raised group flex flex-col justify-between p-8">
          <div>
            <h3 class="text-xl font-semibold tracking-tight">All projects</h3>
            <p class="mt-3 max-w-[40ch] leading-relaxed text-muted">
              PPPoE platform baseline, failover scenarios, dan automation lain — lengkap dengan problem, solution, outcome.
            </p>
          </div>
          <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors group-hover:text-ink">
            Browse projects
            <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
          </span>
        </a>
      </div>

      <!-- NOW BUILDING -->
      <article class="reveal panel mt-6 border-accent/20 p-8 md:p-10">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <p class="mono-label text-accent">Now building</p>
          <span class="tag border-accent/30 text-accent">Private · In development</span>
        </div>
        <h3 class="display mt-4 text-2xl">Skynet e-Billing — ISP operations platform</h3>
        <p class="mt-4 max-w-[62ch] leading-relaxed text-muted">
          Platform internal yang saya bangun untuk memangkas pekerjaan manual NOC —
          dari provisioning sampai penagihan, dijalankan dari satu tempat.
          Detail teknis ditutup selama masa pengembangan.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="tag">OLT provisioning</span>
          <span class="tag">MikroTik</span>
          <span class="tag">RADIUS</span>
          <span class="tag">Invoice & payment gateway</span>
          <span class="tag">WA-gateway ticketing</span>
          <span class="tag">PSB & migrasi otomatis via WhatsApp</span>
        </div>
      </article>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Experience</h2>

      <div class="divide-y divide-line border-y border-line">
        {experience.map((exp) => (
          <article class="reveal grid gap-4 py-8 md:grid-cols-[auto_1fr_auto] md:gap-10">
            <p class="w-44 shrink-0 pt-1 font-mono text-xs leading-relaxed text-faint">
              {exp.period}
            </p>
            <div>
              <h3 class="font-semibold tracking-tight">{exp.title}</h3>
              <p class="mt-0.5 text-sm text-accent">{exp.company}</p>
              <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-muted">
                {exp.description}
              </p>
              <ul class="mt-4 space-y-1.5">
                {exp.highlights.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <i class="ph ph-minus mt-0.5 text-[10px] text-faint" aria-hidden="true"></i>
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <div class="flex flex-wrap content-start gap-2 md:max-w-48 md:justify-end">
              {exp.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Capabilities</h2>

      <div class="grid gap-10 md:grid-cols-3">
        {skillGroups.map((group) => (
          <div class="reveal border-t border-line-strong pt-6">
            <h3 class="font-semibold tracking-tight">{group.title}</h3>
            <p class="mt-4 text-sm leading-loose text-muted">
              {group.items.join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- EDUCATION & CERTIFICATIONS -->
    <section id="education" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Education & credentials</h2>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="reveal panel p-8 md:p-10">
          <p class="mono-label">B.Sc. — Informatic Engineering</p>
          <h3 class="display mt-3 text-2xl">Universitas Trunojoyo Madura</h3>
          <p class="mt-2 text-sm text-muted">Jul 2020 — Okt 2025 · Bangkalan, Jawa Timur</p>
          <p class="mt-6 font-mono text-3xl text-accent">3.70<span class="text-base text-faint"> / 4.00</span></p>
          <p class="mt-6 max-w-[52ch] text-sm leading-relaxed text-muted">
            Fokus pada jaringan komputer dan administrasi Linux.
            Aktif di komunitas Linux kampus KOELIT, dengan proyek
            optimasi server dan network security.
          </p>
        </div>

        <div class="reveal panel divide-y divide-line p-2">
          {certs.map((cert) => (
            <div class="flex items-center justify-between gap-4 rounded-xl px-6 py-5">
              <div>
                <h4 class="text-sm font-medium">{cert.name}</h4>
                <p class="mt-0.5 text-sm text-faint">{cert.org}</p>
              </div>
              <span class="shrink-0 font-mono text-xs text-faint">{cert.date}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="wrap py-24 md:py-32">
      <div class="panel reveal px-8 py-12 md:px-14 md:py-16">
        <h2 class="display text-3xl md:text-4xl">Let's talk.</h2>
        <p class="mt-4 max-w-[48ch] leading-relaxed text-muted">
          Terbuka untuk posisi NOC / Network Engineer, freelance,
          atau sekadar diskusi soal jaringan.
        </p>
        <a
          href="mailto:ihidayatullah57@gmail.com"
          class="mt-8 inline-flex items-center gap-2 text-xl font-medium tracking-tight text-accent transition-colors hover:text-ink md:text-2xl"
        >
          ihidayatullah57@gmail.com
          <i class="ph ph-arrow-up-right text-2xl" aria-hidden="true"></i>
        </a>

        <div class="mt-10 flex flex-wrap gap-3 border-t border-line pt-8">
          {contacts.map((c) => (
            <a href={c.href} target="_blank" rel="noopener" class="btn btn-secondary">
              <i class={`ph ${c.icon} text-base`} aria-hidden="true"></i>
              {c.label}
            </a>
          ))}
          <span class="btn cursor-default border-line text-muted">
            <i class="ph ph-map-pin text-base" aria-hidden="true"></i>
            Pamekasan, Jawa Timur
          </span>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="wrap flex flex-wrap items-center justify-between gap-4 py-8 text-sm text-faint">
      <p>© 2026 Ikhtiar Hidayatullah</p>
      <p class="font-mono text-xs">Built with Astro + Tailwind CSS</p>
    </div>
  </footer>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
