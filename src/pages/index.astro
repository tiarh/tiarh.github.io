---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { PROJECTS } from "../data/projects";
import { STATS } from "../data/stats";
import { SERVICES } from "../data/services";
import { PROFILE } from "../data/profile";
import { SKILLS } from "../data/cv";
import { CERTIFICATES } from "../data/certificates";
import { DEVICE_GROUPS } from "../data/infrastructure";
import experience from "../data/experience";

const featured = PROJECTS.filter((p) => p.featured);
const [mainProject, ...otherFeatured] = featured;
const moreProjects = PROJECTS.filter((p) => !p.featured);

const stack = [
  { name: "MikroTik", slug: "mikrotik" },
  { name: "Linux", slug: "linux" },
  { name: "Laravel", slug: "laravel" },
  { name: "React", slug: "react" },
  { name: "Docker", slug: "docker" },
  { name: "Grafana", slug: "grafana" },
  { name: "Prometheus", slug: "prometheus" },
  { name: "GitHub Actions", slug: "githubactions" },
];

const contacts = [
  { icon: "ph-whatsapp-logo", label: "WhatsApp", href: "https://wa.me/6285234415861" },
  { icon: "ph-telegram-logo", label: "Telegram", href: "https://t.me/lumayancuk" },
  { icon: "ph-github-logo", label: "GitHub", href: "https://github.com/tiarh" },
  { icon: "ph-linkedin-logo", label: "LinkedIn", href: "https://www.linkedin.com/in/ikhtiarh" },
];
---

<BaseLayout title="Ikhtiar Hidayatullah — NOC Engineer, Network & Automation">
  <SiteHeader />

  <main>
    <!-- HERO -->
    <section id="top" class="wrap flex min-h-[100dvh] flex-col justify-center pb-16 pt-28 md:pt-32">
      <div class="grid items-center gap-12 lg:grid-cols-[1.3fr_0.7fr]">
        <div>
          <p class="mb-6 flex items-center gap-2.5 font-mono text-xs tracking-wide text-muted">
            <span class="status-dot"></span>
            Available for opportunities
          </p>

          <h1 class="display text-5xl sm:text-6xl md:text-7xl xl:text-[5.5rem]">
            Ikhtiar<br />Hidayatullah
          </h1>

          <p class="mt-4 font-mono text-sm text-accent">{experience[0].title.en} · Skynet</p>

          <p class="mt-6 max-w-[46ch] text-xl leading-snug text-ink">
            {PROFILE.headline}
          </p>
          <p class="mt-4 max-w-[58ch] leading-relaxed text-muted">
            {PROFILE.intro}
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href={PROFILE.cv.en} download class="btn btn-primary">
              <i class="ph ph-download-simple text-base" aria-hidden="true"></i>
              Download CV
            </a>
            <a href="/cv" class="btn btn-secondary">
              CV page (EN / ID)
            </a>
            <a href="#work" class="btn btn-secondary">
              View work
              <i class="ph ph-arrow-down text-base" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <figure class="panel mx-auto w-full max-w-[260px] overflow-hidden md:max-w-[300px]">
          <img
            src="/images/profile.webp"
            alt="Portrait of Ikhtiar Hidayatullah"
            class="aspect-[4/5] w-full object-cover grayscale-[15%]"
            width="640"
            height="962"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>

      <!-- Ops track record -->
      <dl class="mt-20 grid grid-cols-2 gap-y-8 border-t border-line pt-8 md:grid-cols-4">
        {STATS.map((s) => (
          <div>
            <dd class="font-mono text-2xl font-medium text-ink">{s.value}</dd>
            <dt class="mt-1 text-sm text-faint">{s.label}</dt>
          </div>
        ))}
      </dl>
    </section>

    <!-- STACK STRIP -->
    <section class="border-y border-line" aria-label="Core stack">
      <div class="wrap flex flex-wrap items-center gap-x-8 gap-y-4 py-6">
        {stack.map((tool) => (
          <span class="flex items-center gap-2 text-sm text-muted">
            <img
              src={`https://cdn.simpleicons.org/${tool.slug}/a4aab1`}
              alt=""
              width="18"
              height="18"
              loading="lazy"
            />
            {tool.name}
          </span>
        ))}
      </div>
    </section>

    <!-- SELECTED WORK -->
    <section id="work" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Selected work</h2>

      {mainProject && (
        <article class="reveal panel panel-raised overflow-hidden">
          <div class="grid lg:grid-cols-[0.9fr_1.1fr]">
            <div class="p-6 md:p-10">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-xl font-semibold tracking-tight">{mainProject.title}</h3>
                <span class="tag border-accent/30 text-accent">{mainProject.status}</span>
              </div>
              <p class="mt-4 max-w-[52ch] leading-relaxed text-muted">{mainProject.summary}</p>
              <ul class="mt-6 space-y-2">
                {mainProject.scale.map((s) => (
                  <li class="flex items-start gap-2.5 font-mono text-sm text-muted">
                    <i class="ph ph-gauge mt-0.5 text-accent" aria-hidden="true"></i>
                    {s}
                  </li>
                ))}
              </ul>
              <div class="mt-6 flex flex-wrap gap-2">
                {mainProject.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <a
                href={`/projects/${mainProject.slug}`}
                class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-ink"
              >
                Read case study
                <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
              </a>
            </div>
            {mainProject.gallery?.[0] && (
              <div class="border-t border-line bg-surface-2 lg:border-l lg:border-t-0">
                <img
                  src={mainProject.gallery[0].src}
                  alt={mainProject.gallery[0].alt}
                  width={mainProject.gallery[0].width}
                  height={mainProject.gallery[0].height}
                  class="h-full w-full object-cover object-left-top"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        </article>
      )}

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {otherFeatured.map((p) => (
          <a href={`/projects/${p.slug}`} class="reveal panel panel-raised group flex flex-col overflow-hidden">
            {p.gallery?.[0] && (
              <img
                src={p.gallery[0].src}
                alt=""
                width={p.gallery[0].width}
                height={p.gallery[0].height}
                class="aspect-[16/9] w-full border-b border-line object-cover object-left-top"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="flex flex-1 flex-col p-6 md:p-8">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-xl font-semibold tracking-tight transition-colors group-hover:text-accent">{p.title}</h3>
                <span class="tag border-accent/30 text-accent">{p.status}</span>
              </div>
              <p class="mt-4 leading-relaxed text-muted">{p.summary}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-medium text-accent">
                Read case study
                <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="reveal mt-6 panel divide-y divide-line">
        {moreProjects.map((p) => (
          <a href={`/projects/${p.slug}`} class="group flex items-center justify-between gap-4 px-6 py-5 md:px-8">
            <div class="min-w-0">
              <p class="font-medium tracking-tight transition-colors group-hover:text-accent">{p.title}</p>
              <p class="mt-1 text-sm text-faint">{p.tags.join(" · ")}</p>
            </div>
            <i class="ph ph-arrow-right shrink-0 text-accent" aria-hidden="true"></i>
          </a>
        ))}
      </div>
    </section>

    <!-- INFRASTRUCTURE TEASER -->
    <section class="wrap pb-24 md:pb-32">
      <a href="/infrastructure" class="reveal panel panel-raised group block p-6 md:p-10">
        <p class="mono-label text-accent">Infrastructure</p>
        <h2 class="display mt-4 text-2xl md:text-3xl">The network behind it</h2>
        <p class="mt-4 max-w-[62ch] leading-relaxed text-muted">
          MikroTik edge and POP routers on metro, VLAN + OSPF and tunnel links, OLTs from three vendors,
          1,000+ ONUs on GenieACS, and the Proxmox / Docker platform that runs the tools.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {DEVICE_GROUPS.map((g) => <span class="tag">{g.title}</span>)}
        </div>
        <span class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
          See devices and topology
          <i class="ph ph-arrow-right text-base transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i>
        </span>
      </a>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Experience</h2>

      <div class="divide-y divide-line border-y border-line">
        {experience.map((exp) => (
          <article class="reveal grid gap-4 py-8 md:grid-cols-[auto_1fr_auto] md:gap-10">
            <p class="w-44 shrink-0 pt-1 font-mono text-xs leading-relaxed text-faint">
              {exp.period.en}
            </p>
            <div>
              <h3 class="font-semibold tracking-tight">{exp.title.en}</h3>
              <p class="mt-0.5 text-sm text-accent">{exp.company.en}</p>
              <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-muted">
                {exp.description.en}
              </p>
              <ul class="mt-4 space-y-1.5">
                {exp.highlights.en.map((h) => (
                  <li class="flex items-start gap-2.5 text-sm text-muted">
                    <i class="ph ph-minus mt-0.5 text-[10px] text-faint" aria-hidden="true"></i>
                    {h}
                  </li>
                ))}
              </ul>
            </div>
            <div class="flex flex-wrap content-start gap-2 md:max-w-48 md:justify-end">
              {exp.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Capabilities</h2>

      <div class="grid gap-10 md:grid-cols-3">
        {SKILLS.map((group) => (
          <div class="reveal border-t border-line-strong pt-6">
            <h3 class="font-semibold tracking-tight">{group.title.en}</h3>
            <p class="mt-4 text-sm leading-loose text-muted">
              {group.items.en.split(", ").join(" · ")}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="wrap py-24 md:py-32">
      <h2 class="display mb-4 text-3xl md:text-4xl">What I can help with</h2>
      <p class="mb-12 max-w-[56ch] leading-relaxed text-muted">
        Open for freelance and part-time engagements around ISP operations
        and the tooling that keeps them running.
      </p>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((service) => (
          <div class="reveal panel panel-raised flex flex-col p-7">
            <h3 class="font-semibold tracking-tight">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{service.description}</p>
            <ul class="mt-5 space-y-1.5 border-t border-line pt-4">
              {service.bullets.map((b) => (
                <li class="flex items-start gap-2.5 font-mono text-xs text-faint">
                  <i class="ph ph-check text-accent" aria-hidden="true"></i>
                  {b}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="wrap py-24 md:py-32">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="reveal">
          <h2 class="display text-3xl md:text-4xl">About</h2>
          <p class="mt-8 max-w-[54ch] leading-relaxed text-muted">
            I got into networking through my campus Linux community at
            Trunojoyo University, then made it official with network
            installation training at BLK Surabaya.
          </p>
          <p class="mt-5 max-w-[54ch] leading-relaxed text-muted">
            Today I run NOC operations at Skynet, an FTTH ISP — and what I enjoy
            most is the seam between networks and code: if an ops task repeats,
            there is usually a tool that should be doing it, with tests and a
            rollback.
          </p>
          <a href="/uses" class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-ink">
            See my daily toolkit
            <i class="ph ph-arrow-right text-base" aria-hidden="true"></i>
          </a>
        </div>

        <div class="reveal panel self-start p-8">
          <p class="mono-label">Home lab — where I test things first</p>
          <ul class="mt-6 space-y-5">
            <li>
              <h3 class="text-sm font-semibold">MikroTik CHR / RouterOS VMs</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                Routing, recursive failover, and queue experiments — rehearsed in VMs before touching production routers.
              </p>
            </li>
            <li>
              <h3 class="text-sm font-semibold">Routing protocol labs</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                VLAN segmentation plus RIP / OSPF / BGP scenarios in network simulation.
              </p>
            </li>
            <li>
              <h3 class="text-sm font-semibold">Linux playground</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                systemd services, cron automation, and SSH hardening drills.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- EDUCATION & CERTIFICATIONS -->
    <section id="education" class="wrap py-24 md:py-32">
      <h2 class="display mb-12 text-3xl md:text-4xl">Education & credentials</h2>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="reveal panel p-8 md:p-10">
          <p class="mono-label">B.Sc. — Informatic Engineering</p>
          <h3 class="display mt-3 text-2xl">Universitas Trunojoyo Madura</h3>
          <p class="mt-2 text-sm text-muted">Jul 2020 — Oct 2025 · Bangkalan, East Java</p>
          <p class="mt-6 font-mono text-3xl text-accent">3.70<span class="text-base text-faint"> / 4.00</span></p>
          <p class="mt-6 max-w-[52ch] text-sm leading-relaxed text-muted">
            Focused on computer networks and Linux administration.
            Active member of the campus KOELIT Linux community, with
            projects in server optimization and network security.
          </p>
        </div>

        <div class="reveal panel divide-y divide-line p-2">
          {CERTIFICATES.map((cert) => (
            <div class="flex items-center justify-between gap-4 rounded-xl px-6 py-5">
              <div>
                <h4 class="text-sm font-medium">{cert.title}</h4>
                <p class="mt-0.5 text-sm text-faint">{cert.issuer}</p>
              </div>
              <span class="shrink-0 font-mono text-xs text-faint">{cert.date}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="wrap py-24 md:py-32">
      <div class="panel reveal px-8 py-12 md:px-14 md:py-16">
        <h2 class="display text-3xl md:text-4xl">Let's talk.</h2>
        <p class="mt-4 max-w-[48ch] leading-relaxed text-muted">
          Open to NOC / Network Engineer roles, freelance projects,
          or just a conversation about networks.
        </p>
        <a
          href="mailto:ihidayatullah57@gmail.com"
          class="mt-8 inline-flex items-center gap-2 text-xl font-medium tracking-tight text-accent transition-colors hover:text-ink md:text-2xl"
        >
          ihidayatullah57@gmail.com
          <i class="ph ph-arrow-up-right text-2xl" aria-hidden="true"></i>
        </a>

        <div class="mt-10 flex flex-wrap gap-3 border-t border-line pt-8">
          {contacts.map((c) => (
            <a href={c.href} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <i class={`ph ${c.icon} text-base`} aria-hidden="true"></i>
              {c.label}
            </a>
          ))}
          <span class="btn cursor-default border-line text-muted">
            <i class="ph ph-map-pin text-base" aria-hidden="true"></i>
            Pamekasan, East Java · Indonesia
          </span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );
    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
